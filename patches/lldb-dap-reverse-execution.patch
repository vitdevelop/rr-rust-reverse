+/// The `stepBack` request would single-step the given thread one source
+/// line/instruction backwards. LLDB has no reverse step-over/step-into thread
+/// plan or SB API - only reverse *continue* (`SBProcess::ContinueInDirection`).
+///
+/// A reverse single-step built on top of reverse-continue plus temporary
+/// breakpoints is a non-trivial design problem (recursion, inlining, frame
+/// identity) and is intentionally out of scope here. Until LLDB grows a real
+/// reverse-step capability this request is answered with an explicit error so
+/// the client can fall back to `reverseContinue`.
+Error StepBackRequestHandler::Run(const StepBackArguments &) const {
+  return make_error<DAPError>(
+      "reverse stepping (stepBack) is not supported; use reverseContinue "
+      "with a breakpoint instead");
+}
+
+} // namespace lldb_dap
