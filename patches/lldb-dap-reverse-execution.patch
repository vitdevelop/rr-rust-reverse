+    def request_reverseContinue(self, threadId=None, singleThread=False):
+        if self.exit_status is not None:
+            raise ValueError("request_reverseContinue called after process exited")
+        args_dict = {}
+        if threadId is None:
+            threadId = self.get_thread_id()
+        if threadId:
+            args_dict["threadId"] = threadId
+        if singleThread:
+            args_dict["singleThread"] = True
+        command_dict = {
+            "command": "reverseContinue",
+            "type": "request",
+            "arguments": args_dict,
+        }
+        response = self._send_recv(command_dict)
+        if response["success"]:
+            self._process_continued(True)
+        # Caller must still call wait_for_stopped.
+        return response
+
+    def request_stepBack(self, threadId, granularity="statement"):
+        if self.exit_status is not None:
+            raise ValueError("request_stepBack called after process exited")
+        args_dict = {"threadId": threadId, "granularity": granularity}
+        command_dict = {
+            "command": "stepBack",
+            "type": "request",
+            "arguments": args_dict,
+        }
+        return self._send_recv(command_dict)
+
