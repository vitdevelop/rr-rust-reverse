@@ -0,0 +1,54 @@
+//===-- ReverseContinueRequestHandler.cpp ---------------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "DAP.h"
+#include "DAPError.h"
+#include "Handler/RequestHandler.h"
+#include "LLDBUtils.h"
+#include "Protocol/ProtocolRequests.h"
+#include "lldb/API/SBError.h"
+#include "lldb/API/SBProcess.h"
+#include "lldb/lldb-enumerations.h"
+#include "llvm/Support/Error.h"
+
+using namespace llvm;
+using namespace lldb;
+using namespace lldb_dap::protocol;
+
+namespace lldb_dap {
+
+/// The request resumes backward execution of all threads, until a breakpoint is
+/// hit or the beginning of the recorded history is reached ("history boundary",
+/// reported as an ordinary `stopped` event with reason `history boundary`).
+///
+/// Reverse execution requires a record/replay backend such as `rr`;
+/// `SBProcess::ContinueInDirection` fails cleanly for a process that does not
+/// support it (for example a plain `lldb-server` or non-rr `gdb-remote`
+/// target), which is surfaced here as a DAP error response.
+Error ReverseContinueRequestHandler::Run(
+    const ReverseContinueArguments &args) const {
+  SBProcess process = dap.target.GetProcess();
+
+  if (!SBDebugger::StateIsStoppedState(process.GetState()))
+    return make_error<NotStoppedError>();
+
+  // Record/replay backends rewind the entire process; a single thread cannot be
+  // run backwards while the others stay put. Rather than silently reversing
+  // every thread, reject the single-thread request.
+  if (args.singleThread)
+    return make_error<DAPError>(
+        "single-thread reverse execution is not supported");
+
+  SBError error = process.ContinueInDirection(lldb::eRunReverse);
+  if (error.Fail())
+    return ToError(error);
+
+  return Error::success();
+}
+
+} // namespace lldb_dap
