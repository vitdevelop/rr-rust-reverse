index 000000000..1966379bc
--- /dev/null
+++ b/lldb/test/API/tools/lldb-dap/reverse-execution/main.c
@@ -0,0 +1,20 @@
+// Marker functions. Recording (see lldbreverse.ReverseTestBase) is enabled while
+// execution is between the start of start_recording() and the start of
+// stop_recording(); reverse execution can then rewind through everything in
+// between, including the calls to trigger_breakpoint().
+
+int g_value = 0;
+
+static void start_recording() {}
+
+static void trigger_breakpoint(int round) { g_value += round; }
+
+static void stop_recording() {}
+
+int main() {
+  start_recording();
+  for (int round = 0; round < 4; ++round)
+    trigger_breakpoint(round);
+  stop_recording();
+  return 0;
+}
