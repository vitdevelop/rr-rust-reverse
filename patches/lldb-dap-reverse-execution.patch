 };
 
+/// Resumes backward execution of the process. Only meaningful against a
+/// record/replay backend such as `rr`; against any other target the underlying
+/// `SBProcess::ContinueInDirection` call fails and a DAP error is returned.
+///
+/// Advertising the `supportsStepBack` capability (see `GetSupportedFeatures`)
+/// also makes clients send `stepBack`; that request is answered with an
+/// explicit "not supported" error, see `StepBackRequestHandler`.
+class ReverseContinueRequestHandler
+    : public RequestHandler<protocol::ReverseContinueArguments,
+                            protocol::ReverseContinueResponse> {
+public:
+  using RequestHandler::RequestHandler;
+  static llvm::StringLiteral GetCommand() { return "reverseContinue"; }
+  FeatureSet GetSupportedFeatures() const override {
+    return {protocol::eAdapterFeatureStepBack};
+  }
+  llvm::Error Run(const protocol::ReverseContinueArguments &args) const override;
+};
+
+/// The `stepBack` request (single-step backwards) has no implementation in LLDB:
+/// there is no reverse step-over/step-into thread plan or SB API, only reverse
+/// *continue*. This handler therefore always returns a DAP error directing the
+/// client to use `reverseContinue`. It is still registered so that the error is
+/// a clear, typed message rather than a generic "unknown request".
+class StepBackRequestHandler
+    : public RequestHandler<protocol::StepBackArguments,
+                            protocol::StepBackResponse> {
+public:
+  using RequestHandler::RequestHandler;
+  static llvm::StringLiteral GetCommand() { return "stepBack"; }
+  llvm::Error Run(const protocol::StepBackArguments &args) const override;
+};
+
 class ConfigurationDoneRequestHandler
     : public RequestHandler<protocol::ConfigurationDoneArguments,
                             protocol::ConfigurationDoneResponse> {
