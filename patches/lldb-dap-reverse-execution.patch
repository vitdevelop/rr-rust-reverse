diff --git a/lldb/test/API/tools/lldb-dap/reverse-execution/TestDAP_reverseExecution.py b/lldb/test/API/tools/lldb-dap/reverse-execution/TestDAP_reverseExecution.py
new file mode 100644
index 000000000..42e1a5c0b
--- /dev/null
+++ b/lldb/test/API/tools/lldb-dap/reverse-execution/TestDAP_reverseExecution.py
@@ -0,0 +1,160 @@
+"""
+Test lldb-dap reverse execution: the `reverseContinue` and `stepBack` requests
+and the `supportsStepBack` capability.
+
+The positive `reverseContinue` cases reuse lldbreverse.ReverseTestBase, which
+puts a recording gdbserver proxy in front of lldb-server so reverse execution
+can be exercised without rr installed (see also
+lldb/test/API/functionalities/reverse-execution).
+"""
+
+import os
+
+import lldbdap_testcase
+from lldbsuite.test.decorators import *
+from lldbsuite.test.lldbreverse import ReverseTestBase
+from lldbsuite.test.lldbtest import *
+
+
+def error_message(response):
+    """Human-readable text from a failed DAP response."""
+    if response.get("message"):
+        return response["message"]
+    return response.get("body", {}).get("error", {}).get("format", "")
+
+
+class TestDAP_reverseExecutionErrors(lldbdap_testcase.DAPTestCaseBase):
+    """Cases that do not need a recording backend."""
+
+    def test_supports_step_back_capability(self):
+        """`initialize` advertises `supportsStepBack` unconditionally so that
+        clients offer `reverseContinue`."""
+        self.create_debug_adapter()
+        self.addTearDownHook(lambda: self.dap_server.terminate())
+        resp = self.dap_server.request_initialize()
+        self.assertTrue(resp["success"])
+        self.assertEqual(resp["body"]["supportsStepBack"], True)
+
+    @skipIfWindows
+    def test_reverse_continue_errors_without_reverse_support(self):
+        """Against an ordinary (non-record/replay) process, `reverseContinue`
+        returns a clean DAP error rather than crashing or hanging."""
+        program = self.getBuildArtifact("a.out")
+        self.build_and_launch(program)
+        bp_ids = self.set_function_breakpoints(["trigger_breakpoint"])
+        self.continue_to_breakpoints(bp_ids)
+
+        tid = self.dap_server.get_thread_id()
+        resp = self.dap_server.request_reverseContinue(threadId=tid)
+        self.assertFalse(resp["success"])
+        self.assertIn("reverse", error_message(resp).lower())
+
+        # The process is still alive and responsive.
+        self.dap_server.request_setFunctionBreakpoints([])
+        self.continue_to_exit()
+
+    @skipIfWindows
+    def test_step_back_is_not_supported(self):
+        """`stepBack` always returns a clean 'not supported' DAP error."""
+        program = self.getBuildArtifact("a.out")
+        self.build_and_launch(program)
+        bp_ids = self.set_function_breakpoints(["trigger_breakpoint"])
+        self.continue_to_breakpoints(bp_ids)
+
+        tid = self.dap_server.get_thread_id()
+        resp = self.dap_server.request_stepBack(threadId=tid)
+        self.assertFalse(resp["success"])
+        self.assertIn("not supported", error_message(resp).lower())
+
+        self.dap_server.request_setFunctionBreakpoints([])
+        self.continue_to_exit()
+
+
+class TestDAP_reverseContinue(lldbdap_testcase.DAPTestCaseBase, ReverseTestBase):
+    """`reverseContinue` cases driven through the recording gdbserver proxy."""
+
+    def tearDown(self):
+        # The lldb-dap adapter holds the client end of the proxy connection.
+        # GDBProxyTestBase.tearDown() joins the proxy server thread, which only
+        # returns once that connection is closed - so kill the adapter first.
+        try:
+            if getattr(self, "dap_server", None) is not None:
+                self.dap_server.terminate()
+        finally:
+            super().tearDown()
+
+    def setup_dap_recording(self):
+        """Attach lldb-dap through the recording proxy, run forward to
+        `stop_recording`, and return the stopped thread id. Reverse execution is
+        then possible back to the start of `start_recording`.
+
+        On return no breakpoints are set, so a plain `reverseContinue` runs to
+        the history boundary.
+        """
+        self.build()
+        program = self.getBuildArtifact("a.out")
+
+        # Bring up lldb-server behind the recording proxy, then point lldb-dap at
+        # the proxy's TCP port.
+        self.prep_debug_monitor_and_inferior()
+        self.server.start()
+        host, port = self.server._socket._server_socket.getsockname()[:2]
+        if ":" in host:  # IPv6 literal
+            host = "[{}]".format(host)
+        self.create_debug_adapter()
+        self.assertTrue(self.dap_server.request_initialize()["success"])
+        self.dap_server.request_attach(
+            program=program, gdbRemotePort=port, gdbRemoteHostname=host
+        )
+        self.dap_server.wait_for_event(["initialized"])
+
+        marker_bps = self.set_function_breakpoints(["start_recording", "stop_recording"])
+        self.dap_server.request_configurationDone()
+
+        # Run to start_recording, turn recording on, run to stop_recording.
+        self.dap_server.wait_for_stopped()
+        frame = self.dap_server.get_stackFrame()
+        self.assertIn("start_recording", frame["name"])
+        self.start_recording()
+        self.dap_server.request_continue()
+        self.dap_server.wait_for_stopped()
+        frame = self.dap_server.get_stackFrame()
+        self.assertIn("stop_recording", frame["name"])
+        self.stop_recording()
+
+        # Drop the marker breakpoints so they don't interfere with reverse
+        # execution (the recorder stops reverse-continue at any set breakpoint).
+        self.dap_server.request_setFunctionBreakpoints([])
+        return self.dap_server.get_thread_id()
+
+    @skipIfWindows
+    @skipIfRemote
+    def test_reverse_continue_to_breakpoint(self):
+        tid = self.setup_dap_recording()
+
+        # A breakpoint on code that already executed (during recording).
+        self.set_function_breakpoints(["trigger_breakpoint"])
+
+        resp = self.dap_server.request_reverseContinue(threadId=tid)
+        self.assertTrue(resp["success"], resp)
+        self.dap_server.wait_for_stopped()
+
+        frame = self.dap_server.get_stackFrame(threadId=tid)
+        self.assertIn(
+            "trigger_breakpoint",
+            frame["name"],
+            "reverseContinue rewound to the earlier breakpoint",
+        )
+
+    @skipIfWindows
+    @skipIfRemote
+    def test_reverse_continue_to_history_boundary(self):
+        tid = self.setup_dap_recording()
+
+        # No earlier breakpoint: reverse-continue runs to the start of the
+        # recording and stops there, reported as reason "history boundary".
+        resp = self.dap_server.request_reverseContinue(threadId=tid)
+        self.assertTrue(resp["success"], resp)
+        stopped = self.dap_server.wait_for_stopped()
+        reasons = [e["body"].get("reason") for e in stopped if e["event"] == "stopped"]
+        self.assertIn("history boundary", reasons)
diff --git a/lldb/test/API/tools/lldb-dap/reverse-execution/TestDAP_reverseExecutionRR.py b/lldb/test/API/tools/lldb-dap/reverse-execution/TestDAP_reverseExecutionRR.py
new file mode 100644
index 000000000..96b4d431b
--- /dev/null
+++ b/lldb/test/API/tools/lldb-dap/reverse-execution/TestDAP_reverseExecutionRR.py
@@ -0,0 +1,106 @@
+"""
+Phase 3.2: rr-backed end-to-end test for lldb-dap `reverseContinue`.
+
+Unlike TestDAP_reverseExecution.py (which fakes record/replay with a gdbserver
+proxy), this drives the real thing: `rr record` a program, replay it as an
+lldb-compatible gdbserver (`rr replay -s <port> -d lldb`), attach lldb-dap over
+that port, and check that `reverseContinue` rewinds execution and that running
+back past the start of the recording reports a "history boundary" stop.
+
+Skipped unless `rr` is on PATH, so it does not run in ordinary CI.
+"""
+
+import os
+import shutil
+import socket
+import subprocess
+import time
+import unittest
+
+import lldbdap_testcase
+from lldbsuite.test.decorators import *
+from lldbsuite.test.lldbtest import *
+
+
+@unittest.skipUnless(shutil.which("rr"), "rr is not installed")
+@skipIfWindows
+class TestDAP_reverseExecutionRR(lldbdap_testcase.DAPTestCaseBase):
+    def tearDown(self):
+        # Kill the adapter first (it holds the client end of the rr replay
+        # connection), then the rr replay server.
+        try:
+            if getattr(self, "dap_server", None) is not None:
+                self.dap_server.terminate()
+        finally:
+            if getattr(self, "_rr_replay", None) is not None:
+                self._rr_replay.kill()
+                self._rr_replay.wait()
+            super().tearDown()
+
+    def _wait_port(self, port, timeout=20):
+        deadline = time.time() + timeout
+        while time.time() < deadline:
+            try:
+                socket.create_connection(("127.0.0.1", port), timeout=0.5).close()
+                return
+            except OSError:
+                time.sleep(0.1)
+        self.fail("rr replay gdbserver never started listening on %d" % port)
+
+    def test_reverse_continue_rr(self):
+        self.build()
+        program = self.getBuildArtifact("a.out")
+        rr_dir = self.getBuildArtifact("rr-trace")
+        env = dict(os.environ)
+        env["_RR_TRACE_DIR"] = rr_dir
+
+        rec = subprocess.run(
+            ["rr", "record", "-n", program],
+            capture_output=True,
+            text=True,
+            env=env,
+        )
+        if rec.returncode != 0:
+            self.skipTest("rr record failed (perf_event_paranoid?):\n" + rec.stderr)
+
+        port = 50999
+        self._rr_replay = subprocess.Popen(
+            ["rr", "replay", "-s", str(port), "-k", "-d", "lldb"],
+            cwd=rr_dir,
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.DEVNULL,
+            env=env,
+        )
+        self._wait_port(port)
+
+        self.create_debug_adapter()
+        self.assertTrue(self.dap_server.request_initialize()["success"])
+        self.dap_server.request_attach(
+            program=program, gdbRemotePort=port, gdbRemoteHostname="127.0.0.1"
+        )
+        self.dap_server.wait_for_event(["initialized"])
+        bp_ids = self.set_function_breakpoints(["trigger_breakpoint"])
+        self.dap_server.request_configurationDone()
+        self.dap_server.wait_for_stopped()
+        tid = self.dap_server.get_thread_id()
+
+        # Forward to the 3rd hit of trigger_breakpoint().
+        for _ in range(2):
+            self.dap_server.request_continue()
+            self.dap_server.wait_for_stopped()
+        fwd_round = self.get_local_as_int("round", threadId=tid)
+
+        # reverseContinue lands on the SAME breakpoint one iteration earlier.
+        resp = self.dap_server.request_reverseContinue(threadId=tid)
+        self.assertTrue(resp["success"], resp)
+        self.dap_server.wait_for_stopped()
+        rev_round = self.get_local_as_int("round", threadId=tid)
+        self.assertLess(rev_round, fwd_round, "reverseContinue rewound the loop")
+
+        # With no breakpoint, reverse-continue runs to the history boundary.
+        self.dap_server.request_setFunctionBreakpoints([])
+        resp = self.dap_server.request_reverseContinue(threadId=tid)
+        self.assertTrue(resp["success"], resp)
+        stopped = self.dap_server.wait_for_stopped()
+        reasons = [e["body"].get("reason") for e in stopped if e["event"] == "stopped"]
+        self.assertIn("history boundary", reasons)
diff --git a/lldb/test/API/tools/lldb-dap/reverse-execution/main.c b/lldb/test/API/tools/lldb-dap/reverse-execution/main.c
