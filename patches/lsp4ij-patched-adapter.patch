+package com.redhat.devtools.lsp4ij.dap.actions;
+
+import org.eclipse.lsp4j.debug.Capabilities;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * Unit tests for {@link DAPReverseExecutionSupport}, the gating rule for the
+ * "Reverse Continue" / "Step Back" debugger actions.
+ */
+class DAPReverseExecutionSupportTest {
+
+    @Test
+    void notAvailable_whenCapabilitiesMissing() {
+        assertFalse(DAPReverseExecutionSupport.isReverseExecutionAvailable(null));
+    }
+
+    @Test
+    void notAvailable_whenFlagUnset() {
+        assertFalse(DAPReverseExecutionSupport.isReverseExecutionAvailable(new Capabilities()));
+    }
+
+    @Test
+    void notAvailable_whenFlagFalse() {
+        Capabilities capabilities = new Capabilities();
+        capabilities.setSupportsStepBack(false);
+        assertFalse(DAPReverseExecutionSupport.isReverseExecutionAvailable(capabilities));
+    }
+
+    @Test
+    void available_whenFlagTrue() {
+        Capabilities capabilities = new Capabilities();
+        capabilities.setSupportsStepBack(true);
+        assertTrue(DAPReverseExecutionSupport.isReverseExecutionAvailable(capabilities));
+    }
+}
