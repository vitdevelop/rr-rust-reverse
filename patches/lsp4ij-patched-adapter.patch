+package com.redhat.devtools.lsp4ij.dap.actions;
+
+import org.eclipse.lsp4j.debug.Capabilities;
+import org.jetbrains.annotations.Nullable;
+
+/**
+ * Decides whether the reverse-execution debugger actions ("Reverse Continue" / "Step Back")
+ * apply to a session, based purely on the debug adapter's advertised capabilities.
+ * <p>
+ * Kept as a tiny pure helper so the gating rule can be unit tested without a live session.
+ */
+public final class DAPReverseExecutionSupport {
+
+    private DAPReverseExecutionSupport() {
+    }
+
+    /**
+     * Returns {@code true} when the adapter advertised the DAP {@code supportsStepBack}
+     * capability, i.e. it accepts the {@code reverseContinue} / {@code stepBack} requests.
+     *
+     * @param capabilities the capabilities from the adapter's {@code initialize} response,
+     *                     or {@code null} if not received yet.
+     */
+    public static boolean isReverseExecutionAvailable(@Nullable Capabilities capabilities) {
+        return capabilities != null && Boolean.TRUE.equals(capabilities.getSupportsStepBack());
+    }
+}
