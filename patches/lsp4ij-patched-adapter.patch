+
+/**
+ * "Step Back" debugger action: single steps the current thread backwards (DAP
+ * {@code stepBack}). Only shown for adapters that advertise {@code supportsStepBack};
+ * adapters without a real reverse-step implementation answer with a DAP error, which is
+ * surfaced in the debug console.
+ */
+public class StepBackAction extends DAPReverseActionBase {
+
+    public StepBackAction() {
+        super(DAPBundle.messagePointer("dap.action.stepBack.text"),
+                DAPBundle.messagePointer("dap.action.stepBack.description"),
+                DAPDebuggerIcons.StepBack);
+    }
+
+    @Override
+    protected void perform(@NotNull DAPDebugProcess process, @Nullable XSuspendContext context) {
+        process.startStepBack(context);
+    }
+}
