+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+
+/**
+ * "Reverse Continue" debugger action: resumes backward execution until an earlier
+ * breakpoint is hit or the start of the recorded history is reached (DAP
+ * {@code reverseContinue}). Only shown for adapters that advertise
+ * {@code supportsStepBack} (e.g. an rr-backed {@code lldb-dap}).
+ */
+public class ReverseContinueAction extends DAPReverseActionBase {
+
+    public ReverseContinueAction() {
+        super(DAPBundle.messagePointer("dap.action.reverseContinue.text"),
+                DAPBundle.messagePointer("dap.action.reverseContinue.description"),
+                DAPDebuggerIcons.ReverseContinue);
+    }
+
+    @Override
+    protected void perform(@NotNull DAPDebugProcess process, @Nullable XSuspendContext context) {
+        process.reverseResume(context);
+    }
+}
