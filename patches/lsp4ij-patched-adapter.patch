+package com.redhat.devtools.lsp4ij.dap.actions;
+
+import com.intellij.openapi.actionSystem.ActionUpdateThread;
+import com.intellij.openapi.actionSystem.AnAction;
+import com.intellij.openapi.actionSystem.AnActionEvent;
+import com.intellij.openapi.actionSystem.Presentation;
+import com.intellij.openapi.project.Project;
+import com.intellij.xdebugger.XDebugSession;
+import com.intellij.xdebugger.XDebuggerManager;
+import com.intellij.xdebugger.frame.XSuspendContext;
+import com.redhat.devtools.lsp4ij.dap.DAPDebugProcess;
+import com.redhat.devtools.lsp4ij.dap.client.DAPClient;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nls;
+import org.jetbrains.annotations.Nullable;
+
+import javax.swing.*;
+import java.util.function.Supplier;
+
+/**
+ * Base class for the reverse-execution debugger toolbar actions.
+ * <p>
+ * Both actions are added to every DAP session's debugger toolbar by
+ * {@link DAPDebugProcess#registerAdditionalActions}, but they stay hidden unless the
+ * connected adapter advertised the DAP {@code supportsStepBack} capability, so ordinary
+ * DAP sessions are visually unchanged. They are enabled only while the session is
+ * suspended, matching the forward step actions.
+ */
+public abstract class DAPReverseActionBase extends AnAction {
+
+    protected DAPReverseActionBase(@NotNull Supplier<@Nls String> text,
+                                   @NotNull Supplier<@Nls String> description,
+                                   @Nullable Icon icon) {
+        super(text, description, icon);
+    }
+
+    @Override
+    public void update(@NotNull AnActionEvent e) {
+        Presentation presentation = e.getPresentation();
+        XDebugSession session = getDebugSession(e);
+        DAPClient client = getConnectedClient(session);
+        boolean available = client != null && client.isSupportsStepBack();
+        presentation.setVisible(available);
+        presentation.setEnabled(available && session != null && session.isSuspended());
+    }
+
+    @Override
+    public void actionPerformed(@NotNull AnActionEvent e) {
+        XDebugSession session = getDebugSession(e);
+        if (session == null || !session.isSuspended()) {
+            return;
+        }
+        if (session.getDebugProcess() instanceof DAPDebugProcess process) {
+            perform(process, session.getSuspendContext());
+        }
+    }
+
+    /**
+     * Runs the reverse operation against the DAP process for the current suspend context.
+     */
+    protected abstract void perform(@NotNull DAPDebugProcess process, @Nullable XSuspendContext context);
+
+    @Override
+    public @NotNull ActionUpdateThread getActionUpdateThread() {
+        return ActionUpdateThread.EDT;
+    }
+
+    private static @Nullable DAPClient getConnectedClient(@Nullable XDebugSession session) {
+        if (session != null && session.getDebugProcess() instanceof DAPDebugProcess process) {
+            return process.getConnectedClient();
+        }
+        return null;
+    }
+
+    /**
+     * Resolves the current debug session from the action context, falling back to
+     * {@link XDebuggerManager#getCurrentSession()} when the context does not carry it
+     * (e.g. the split debugger UI).
+     */
+    protected static @Nullable XDebugSession getDebugSession(@NotNull AnActionEvent e) {
+        XDebugSession session = e.getDataContext().getData(XDebugSession.DATA_KEY);
+        if (session != null) {
+            return session;
+        }
+        Project project = e.getProject();
+        if (project == null) {
+            return null;
+        }
+        return XDebuggerManager.getInstance(project).getCurrentSession();
+    }
+}
